DATABASE_URL=postgresql+psycopg://verdict:verdict@localhost:5432/verdict

# Leave all keys empty to run in DEMO MODE (full product, canned agent
# outputs, zero AI spend). Add any one key for real AI:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free tier: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Local models: any OpenAI-compatible server. Setting this leaves demo mode.
#   Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1
LOCAL_LLM_BASE_URL=
# LOCAL_LLM_API_KEY=            # only if your server requires one (vLLM --api-key)
# LOCAL_LLM_TIMEOUT_SECONDS=600

# Subscription access via the official CLIs, billed to the plan the API
# host is logged into (`claude login` / `codex login`), not an API key.
# Self-hosted single-operator installs only: these spend YOUR plan.
# CLAUDE_CODE_ENABLED=true
# CODEX_ENABLED=true
# CLI_TIMEOUT_SECONDS=600
# Local/subscription model profiles are allowed by default only when
# CLERK_ISSUER is unset (single operator). Override explicitly:
# ALLOW_LOCAL_PROVIDERS=false

# Force demo mode even with keys present:
# DEMO_MODE=true

# --- Auth (three modes, strongest wins) --------------------------------------
# Per-user auth: set your Clerk instance issuer and every route requires a
# Clerk session JWT with data scoped per user. Frontend needs
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY in apps/web/.env.local.
# CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Shared-secret token (used only when CLERK_ISSUER is empty): single-operator
# stopgap for exposed deploys; clients send "Authorization: Bearer <token>".
API_AUTH_TOKEN=

# Both empty = open local/demo dev mode (everything belongs to the demo user).

# Abuse guards: per-IP request limit on mutating endpoints and a hard
# ceiling on total AI spend per UTC day.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=30
# DAILY_SPEND_LIMIT_USD=25.0
# Number of trusted reverse proxies in front of the API. MUST be 1 behind
# Render/Vercel/Fly (else all users share one rate-limit bucket). 0 = no proxy.
# TRUSTED_PROXY_COUNT=1

# Web search for the Research agent (either enables live research; both
# empty = the agent honestly discloses no web access).
# Brave free tier: https://api-dashboard.search.brave.com
BRAVE_API_KEY=
# Tavily free tier: https://tavily.com
TAVILY_API_KEY=

# Observability (optional; free tiers; pip install '.[observability]')
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
